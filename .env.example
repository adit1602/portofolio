# ============================================================
# Environment Variables — copy to .env and fill in values
# ============================================================

# ---- Postgres ----
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_pass
POSTGRES_DB=portfolio_db
DATABASE_URL="postgresql://portfolio_user:portfolio_pass@localhost:5432/portfolio_db"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- JWT ----
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret

# ---- Admin Seed ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SuperSecret123!

# ---- API (used by web) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
