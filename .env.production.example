# ============================================================
# .env.production — copy ini ke VPS sebagai .env
# Ganti SEMUA nilai di bawah sebelum deploy!
# JANGAN commit file ini ke git.
# ============================================================

# ---- Domain ----
# Web (landing page) and API domains — used by Nginx, not read directly by
# the containers. Keep them under the same registrable domain (e.g. both
# under ditzdev.my.id) so the auth cookie below can be shared between them.
DOMAIN_WEB=ditzdev.my.id
DOMAIN_API=api.ditzdev.my.id

# ---- Postgres ----
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
POSTGRES_DB=portfolio_db
DATABASE_URL=postgresql://portfolio_user:GANTI_PASSWORD_KUAT_DISINI@postgres:5432/portfolio_db

# ---- Redis ----
REDIS_PASSWORD=GANTI_REDIS_PASSWORD_DISINI
REDIS_URL=redis://:GANTI_REDIS_PASSWORD_DISINI@redis:6379

# ---- JWT ----
JWT_SECRET=GANTI_JWT_SECRET_PANJANG_RANDOM_DISINI
JWT_REFRESH_SECRET=GANTI_JWT_REFRESH_SECRET_LAIN_DISINI

# ---- Admin Seed ----
ADMIN_EMAIL=admin@ditzdev.my.id
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT

# ---- API URLs ----
# URL publik API yang diakses BROWSER langsung (via Nginx di subdomain API).
# JANGAN tambahkan suffix /api — kode frontend sudah menambahkannya sendiri,
# dan URL ini juga dipakai mentah untuk path /uploads/*.
NEXT_PUBLIC_API_URL=https://api.ditzdev.my.id
# URL internal API dari sisi server (Next.js SSR → container API langsung,
# lewat Docker network, tidak lewat Nginx/domain publik)
API_URL=http://api:3001

# ---- Auth / CORS ----
# Origin frontend yang diizinkan API untuk CORS (harus persis, termasuk https://)
FRONTEND_URL=https://ditzdev.my.id
# Domain cookie refresh_token, diawali titik agar dibagi ke semua subdomain
# (ditzdev.my.id dan api.ditzdev.my.id). Wajib diisi jika web & API beda subdomain.
COOKIE_DOMAIN=.ditzdev.my.id

# ---- On-demand revalidation ----
# Secret dibagi antara API dan Web — API memanggil web:3000/api/revalidate
# lewat Docker network setiap kali admin selesai create/update/delete, supaya
# landing page ke-update instan (bukan nunggu ISR 60 detik).
REVALIDATE_SECRET=GANTI_REVALIDATE_SECRET_RANDOM_DISINI
